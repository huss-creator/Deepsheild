# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.
# Development works with NO variables set (a per-checkout dev key is generated).

# --- selects settings module: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.production

# --- core (production: all required)
SECRET_KEY=            # >= 50 random chars:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SITE_URL=https://deepshield.example.com
ALLOWED_HOSTS=deepshield.example.com
CSRF_TRUSTED_ORIGINS=https://deepshield.example.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
NUM_PROXIES=1          # trusted reverse proxies in front of Django (for client IP / rate limits)
STATIC_ROOT=/data/staticfiles

# --- PostgreSQL (production)
DB_NAME=deepshield
DB_USER=deepshield
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# --- Redis (production: shared rate-limit/cache store; Celery broker from Phase 7)
REDIS_URL=redis://redis:6379/0

# --- private media
MEDIA_ROOT=/data/media                    # docker-compose volume; bare-metal: /srv/deepshield/media
MEDIA_X_ACCEL_PREFIX=/_protected_media/   # Nginx internal location aliasing MEDIA_ROOT

# --- upload limits
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_PIXELS=25000000

# --- rate limits (max per window: login 15 min, register 1 h, upload 1 h)
RL_LOGIN_FAIL_MAX=5
RL_LOGIN_FAIL_IP_MAX=30
RL_REGISTER_MAX=5
RL_UPLOAD_MAX=20

# --- API / auth (Phase 6)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
REPORT_SIGNING_KEY=              # HMAC key for report signatures (default: SECRET_KEY; rotating it invalidates old signatures)
CORS_ALLOWED_ORIGINS=            # comma-separated explicit origins; empty = no cross-origin browser access
RL_API_USER_MAX=1000             # authenticated API calls per user per hour
RL_RESET_MAX=5                   # password-reset requests per IP per hour
READINESS_MIN_MODELS=1           # /api/v1/system/readiness/ fails below this many available models

# --- e-mail (password reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DeepShield <no-reply@example.com>

# --- AI models (Phase 4)
MODEL_DIR=/models                         # docker-compose mounts ./trained_models here; bare-metal: any absolute path
MODEL_REQUIRE_CHECKSUM=true
DEVICE=auto                      # auto | cuda | cpu
AI_MODEL_TIMEOUT=30
FACE_DETECTOR=haar               # yunet is recommended for higher precision when its model file is installed
YUNET_MODEL_PATH=/models/face_detector/yunet.onnx
FACE_CONFIDENCE_THRESHOLD=0.8
FACE_MIN_SIZE=30
FACE_MIN_AREA_RATIO=0.005
FACE_HAAR_MIN_NEIGHBORS=7
FACE_HAAR_VALIDATE_EYES=true
AI_MAX_FACES=10

# --- background jobs (Phase 7). Run: celery -A config worker -Q analysis -c 1 -l info
#     and schedule `python manage.py reap_jobs` every minute (stuck-job recovery)
CELERY_BROKER_URL=               # defaults to REDIS_URL
PROCESSING_TIMEOUT=180           # soft time limit per job in seconds (hard kill = +30)
JOB_MAX_RETRIES=2                # transient failures only
JOB_RETRY_BACKOFF=5              # seconds, doubled each retry (cap 300)
MAX_ACTIVE_JOBS_PER_USER=3
MAX_QUEUED_JOBS=200
STUCK_JOB_SECONDS=540

# --- object storage (optional). STORAGE_BACKEND=local keeps files under MEDIA_ROOT.
STORAGE_BACKEND=local            # local | s3  (any S3-compatible service; bucket MUST be private)
S3_BUCKET=
S3_ENDPOINT_URL=                 # empty = AWS; MinIO/R2: https://...
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=                # empty = use IAM role / instance profile
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_SECONDS=120        # lifetime of pre-signed image URLs
S3_SSE=true                      # server-side encryption (AES256)

# --- privacy / retention
DELETE_ANALYSIS_AFTER_DAYS=30    # 0 = keep until the user deletes. Enforced by `manage.py purge_expired` (scheduler container)
AUDIT_LOG_RETENTION_DAYS=365

# --- observability
LOG_FORMAT=json                  # json | text
LOG_LEVEL=INFO
SENTRY_DSN=                      # empty = disabled; PII and request bodies are never sent
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=                   # enables GET /metrics for Prometheus (Authorization: Bearer <token>); empty = disabled
PROMETHEUS_MULTIPROC_DIR=        # set to a shared writable dir to aggregate across gunicorn workers
